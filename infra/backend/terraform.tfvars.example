# Copy to terraform.tfvars and adjust before applying in a new Azure account.

project_name = "labelverify"
environment  = "dev"
location     = "eastus"

# Pin deployment to the new Azure account/subscription.
# Keep these in terraform.tfvars; do not commit real account IDs.
subscription_id = "00000000-0000-0000-0000-000000000000"
tenant_id       = "00000000-0000-0000-0000-000000000000"

# ACR names are globally unique. Use a short lowercase suffix for each redeploy.
name_suffix = "a1"

# Optional: uncomment to force a specific new resource group name instead of
# the generated rg-labelverify-dev-a1.
# resource_group_name = "rg-labelverify-dev-a1"

container_image_tag = "latest"
container_cpu       = 2.0
container_memory    = "4Gi"
min_replicas        = 1
max_replicas        = 3

# Leave false for a normal new subscription. Set true only if provider
# registration is managed externally by the Azure tenant/admin.
skip_provider_registration = false
